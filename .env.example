PROJECT_NAME=YourProjectName

# ── SonarCloud ────────────────────────────────────────────────────────────────
SONAR_URL=https://sonarcloud.io
SONAR_TOKEN=your_token_here
SONAR_PROJECT_KEY=your_project_key

# ── InfluxDB v2 ───────────────────────────────────────────────────────────────
# Full URL of the InfluxDB instance (Cloud or self-hosted)
# Cloud example: https://eu-central-1-1.aws.cloud2.influxdata.com
# Self-hosted example: http://localhost:8086
INFLUX_URL=https://your-influxdb-host

# API token with write access to the target bucket
INFLUX_TOKEN=your_influxdb_token_here

# Organisation name (as shown in the InfluxDB UI)
INFLUX_ORG=your_organisation_name

# Bucket where KPI metrics will be written
INFLUX_BUCKET=engineering_kpis

# (Optional) Request timeout in milliseconds — default: 10000
# INFLUX_TIMEOUT=10000

# ── OneDrive / Microsoft Graph ────────────────────────────────────────────────
# Optional — only used by the standalone src/utils/onedrive/ utility, which is
# NOT called by the active pipeline (calculate_kpis.py). See CLAUDE.md's
# "Utilities" section. Leave unset unless you're running that utility directly.

# Application (client) ID from your Azure app registration
# (Azure Portal → App registrations → your app → Overview)
# ONEDRIVE_CLIENT_ID=your_azure_app_client_id

# (Optional) "consumers" for personal Microsoft accounts (default),
# "organizations" for work/school accounts, or a specific tenant ID
# ONEDRIVE_TENANT=consumers

# (Optional) OneDrive folder where kpi_results.csv/.xlsx are uploaded — default: /PreseHome-KPIs
# ONEDRIVE_TARGET_FOLDER=/PreseHome-KPIs

# (Optional) Path to the local MSAL token cache file — default: <project root>/.onedrive_token_cache.json
# ONEDRIVE_TOKEN_CACHE_PATH=.onedrive_token_cache.json